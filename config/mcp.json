{
  "mcpServers": {
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-server-time",
        "--local-timezone=Europe/Prague"
      ],
      "icon": "\u23f0"
    },
    "openstreetmap-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/openstreetmap-mcp-server"
      ],
      "env": {
        "OSM_USER_AGENT": "animarium-lunar-mcpx/1.0"
      }
    },
    "osrm": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@pipeworx/mcp-osrm"
      ],
      "env": {
        "PIPEWORX_API_KEY": "${PIPEWORX_API_KEY}"
      }
    },
    "pipeworx": {
      "type": "streamable-http",
      "url": "https://gateway.pipeworx.io/mcp",
      "headers": {
        "Authorization": "Bearer ${PIPEWORX_API_KEY}"
      }
    },
    "open-streetmap-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "osm-mcp-server"
      ]
    },
    "switzerland-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-swiss"
      ]
    },
    "clio-geojson": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "clio-kit",
        "mcp-server",
        "geojson"
      ]
    }
  }
}
