{
  "mcpServers": {
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-server-time",
        "--local-timezone=Europe/Prague"
      ],
      "icon": "⏰"
    },
    "openstreetmap-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/openstreetmap-mcp-server"
      ],
      "env": {
        "OSM_USER_AGENT": "animarium-lunar-mcpx/1.0"
      }
    },
    "osrm": {
      "type": "streamable-http",
      "url": "https://gateway.pipeworx.io/osrm/mcp"
    }
  }
}
