{
  "mcpServers": {
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-server-time",
        "--local-timezone=Europe/Prague"
      ],
      "icon": "⏰"
    },
    "openstreetmap-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/openstreetmap-mcp-server"
      ],
      "env": {
        "OSM_USER_AGENT": "animarium-lunar-mcpx/1.0"
      }
    },
    "osrm": {
      "type": "streamable-http",
      "url": "https://gateway.pipeworx.io/osrm/mcp"
    },
    "geocode-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "geocode-mcp"
      ],
      "env": {
        "GEOCODE_USER_AGENT": "MyGeographicApp/1.0 (contact@example.com)"
      }
    },
    "mcp-nominatim": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@pipeworx/mcp-nominatim"
      ]
    },
    "open-streetmap-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "osm-mcp-server"
      ]
    },
    "switzerland-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-swiss"
      ]
    },
    "clio-geojson": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "clio-kit",
        "mcp-server",
        "geojson"
      ]
    }
  }
}
