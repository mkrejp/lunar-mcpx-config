# =============================================================================
# lunar-mcpx — Railway variables
# Copy names/values into the `lunar-mcpx` service Variables tab.
# Never commit real secrets. AUTH_KEY and LUNAR_API_KEY stay empty here.
#
# Required = needed for a working public Railway deploy of this repo.
# Optional = upstream defaults are fine for a first start.
# =============================================================================

# -----------------------------------------------------------------------------
# Required for Railway
# -----------------------------------------------------------------------------

# Railway healthchecks hit $PORT. Must match MCPX_PORT and the public domain
# target port (9000).
PORT=9000

# MCP Gateway HTTP listen port (MCP endpoint + healthcheck). Default: 9000
MCPX_PORT=9000
MCPX_SERVER_PORT=9000

# Internal URL used by the in-container UI/control-plane to reach the server.
MCPX_SERVER_URL=http://127.0.0.1:9000

# Control Plane UI listen port. Default: 5173
UI_PORT=5173
UI_URL=http://127.0.0.1:5173

# Public origin the browser uses to call MCPX (your Railway HTTPS domain).
# Set after generating the public domain targeted at 9000.
# Dashboard value: https://${{RAILWAY_PUBLIC_DOMAIN}}
VITE_MCPX_SERVER_URL=
VITE_MCPX_SERVER_PORT=443

# WebSocket URL for the Control Plane. Usually wss://<same public domain>
# Dashboard value: wss://${{RAILWAY_PUBLIC_DOMAIN}}
VITE_WS_URL=

# CORS allow-list for the UI origin(s). Comma-separated.
# Must include the UI public domain (port 5173) and, if same-origin via
# reverse proxy, the MCP domain. Default in image: localhost Vite ports.
# Dashboard starter: https://${{RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=

# OAuth callback base. Unset = http://127.0.0.1:<MCPX_PORT> (wrong on Railway).
# Dashboard value: https://${{RAILWAY_PUBLIC_DOMAIN}}
OAUTH_CALLBACK_BASE_URL=

# Volume is mounted as root; upstream then drops to uid 1002 (`lunar`).
RAILWAY_RUN_UID=0

# Stdio MCP servers (uvx/npx) without Docker-in-Docker. Default in combined
# image is true. Keep true so the sample `time` server can spawn.
ENABLE_STDIO_MCP_SERVERS=true

# Railway containers are not privileged. The image also auto-disables DinD
# when CapEff is low. Set false explicitly.
DIND_ENABLED=false

# Persist UI-edited config + audit logs on the Railway volume.
APP_CONFIG_PATH=/lunar/packages/mcpx-server/config/app.yaml
SERVERS_CONFIG_PATH=/lunar/packages/mcpx-server/config/mcp.json
AUDIT_LOG_DIR=/lunar/packages/mcpx-server/config/audit-logs

# Do not ship telemetry to Lunar's Loki from a self-hosted instance.
LUNAR_TELEMETRY=false

# -----------------------------------------------------------------------------
# Required for auth (public /mcp)
# -----------------------------------------------------------------------------

# Shared secret. MCPX 0.5.8 reads this env var (mcpx-server/src/env.ts).
# app.yaml must have auth.enabled: true (entrypoint merges that onto the
# volume on every start). Clients send header:
#   x-lunar-api-key: <AUTH_KEY>
# (DEFAULT_API_KEY_HEADER in mcpx-server/src/server/auth.ts; optional
# auth.header in app.yaml overrides). Header x-lunar-auth-key is NOT used.
# Missing/empty AUTH_KEY: the container refuses to start (fail-closed).
# Upstream would otherwise fail-open /mcp with a warning.
AUTH_KEY=

# Pipeworx gateway (config/mcp.json pipeworx + osrm). Never commit the value.
# Injected at container start into X-API-Key: ${PIPEWORX_API_KEY} (and osrm stdio env)
# and into the osrm stdio child's env. Get a key at https://pipeworx.io
# Prefer a single PIPEWORX_API_KEY. If your variable-set path truncates long
# values, set PIPEWORX_API_KEY_P1..P4 (9 chars each); entrypoint concatenates.
PIPEWORX_API_KEY=
# PIPEWORX_API_KEY_P1=
# PIPEWORX_API_KEY_P2=
# PIPEWORX_API_KEY_P3=
# PIPEWORX_API_KEY_P4=

# Comma-separated CIDR allow-list. Unset = all IPs.
# ALLOWED_IP_RANGES=

# -----------------------------------------------------------------------------
# Optional — ports / metrics / logs
# -----------------------------------------------------------------------------

# Prometheus metrics. Default: true / 3000. Keep private (no public domain).
ENABLE_METRICS=true
SERVE_METRICS_PORT=3000

# error | warn | info | http | verbose | debug | silly. Default: info
LOG_LEVEL=info

# ACCESS_LOG_LEVEL=debug
# LOG_HIDE_TAGS=
# LOG_REDACT_KEYS=env

# -----------------------------------------------------------------------------
# Optional — control plane / UI feature flags (baked into UI at container start)
# -----------------------------------------------------------------------------

ENABLE_CONTROL_PLANE_REST=true
ENABLE_CONTROL_PLANE_STREAMING=true

# VITE_ENABLE_LOGIN=false
# VITE_ENABLE_ENTERPRISE=false
# VITE_ENABLE_PERMISSIONS=false
# VITE_ENABLE_CAPABILITIES_UI=false
# VITE_SHOW_MCP_SERVERS=false
# VITE_IS_BOOMI=false
# VITE_ENABLE_PENDO=false
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=mcpx-webapp
# VITE_AUTH_BFF_URL=
# VITE_ADMIN_WEBSERVER_URL=
# VITE_OAUTH_CALLBACK_BASE_URL=
# VITE_ADD_SERVER_CHECKBOX=

# -----------------------------------------------------------------------------
# Optional — standalone vs enterprise hub
# -----------------------------------------------------------------------------

# Leave unset for standalone (this repo). Hub mode pulls config from webapp.
# INSTANCE_KEY=
# INSTANCE_NAME=
# HUB_WS_URL=
# ENFORCE_HUB_CONNECTION=false
# HUB_CONNECTION_TIMEOUT_MS=20000
# HUB_RECONNECT_DELAY_MAX_MS=10000
# READ_TARGET_SERVERS_FROM_FILE=true

# -----------------------------------------------------------------------------
# Optional — Lunar AI Gateway interception (not required for MCPX-only)
# -----------------------------------------------------------------------------

# LUNAR_API_KEY=
# LUNAR_URL=
# WEBSERVER_PORT=http://localhost:9001

