# AGENT_DISCONNECTED_RETENTION_MIN=60
# ENABLE_STREAMABLE_EVENT_STORE=false
# STREAMABLE_EVENT_STORE_MAX_EVENT_AGE_MS=300000

# CONNECTION_TIMEOUT_MS=180000
